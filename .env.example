# Copia a .env.local

GSC_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_PATH=.secrets/gcp-oauth-client.json
GSC_OAUTH_TOKEN_PATH=.secrets/gsc-oauth-token.json
GSC_SITE_URL=sc-domain:katialafono.cl

# Informes y panel (28 días por defecto)
GSC_DASHBOARD_DAYS=28
GSC_REPORT_DAYS=28
# GSC_BRAND_TERMS=katialafono

# Panel /interno/gsc — en producción usar clave en URL
# GSC_DASHBOARD_SECRET=genera-una-clave-larga-aleatoria

# Opcional: otro puerto si 53682 está ocupado al hacer auth
# GSC_OAUTH_PORT=53683

# PageSpeed Insights / Core Web Vitals (panel /interno/gsc + npm run pagespeed:report)
# Google Cloud → habilitar "PageSpeed Insights API" → API key
# PAGESPEED_API_KEY=tu-api-key
# PAGESPEED_STRATEGY=mobile
# PAGESPEED_URLS=https://www.katialafono.cl/,https://www.katialafono.cl/chillan/tel
# PAGESPEED_SKIP=1
# PAGESPEED_TIMEOUT_MS=90000

# Google Ads (gtag sitio)
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18364805586
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_SEND_TO=AW-18364805586/rBy6CNrQsNocENLjgrVE

# Google Ads API (informes). Credenciales: symlink .secrets → gonzalopedrosa
# Doc: GOOGLEADS/google-ads-api-setup.md
# GOOGLE_ADS_OAUTH_CLIENT_PATH=.secrets/gcp-oauth-client-ads.json
# GOOGLE_ADS_OAUTH_TOKEN_PATH=.secrets/google-ads-oauth-token.json
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=2147001598
# No usar LOGIN para Katialafono (acceso directo). Solo si una cuenta cliente lo exige:
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=8057859597
# GOOGLE_ADS_REPORT_DAYS=30
# GOOGLE_ADS_OAUTH_PORT=53683
